{
  "name": "help-page-generator",
  "version": "2.1.0",
  "type": "module",
  "bin": {
    "help-page-generator": "bin/cli.cjs"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --banner:js=\"#!/usr/bin/env node\" --outfile=bin/cli.cjs",
    "prepare": "npm run build:cli",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test-money.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/test-money.mjs --resolve-extensions=.ts,.mts,.js,.mjs && node node_modules/.tmp/test-money.mjs",
    "test:cli": "npm run build:cli && node test/cli.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "xlsx": "^0.18.5"
  }
}
